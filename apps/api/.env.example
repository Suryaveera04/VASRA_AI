# Environment Variables - Sree Ram Silks & VASRĀ AI Catalog API
# Copy this file to .env and populate your actual values

# ─── SERVER ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── DATABASE ─────────────────────────────────────────────
# MongoDB connection string (automatically falls back to In-Memory if not running)
MONGODB_URI=mongodb://127.0.0.1:27017/saree_catalog

# ─── AUTHENTICATION ────────────────────────────────────────
JWT_SECRET=sree_ram_silks_super_secret_jwt_key_2026_luxury

# ─── NVIDIA NIM & OPEN SOURCE AI ENGINE ──────────────────
# Obtain your free API key at https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key-here
# Recommended Chatbot & Stylist reasoning models:
# 1. nvidia/llama-3.1-nemotron-70b-instruct (Recommended)
# 2. meta/llama-3.3-70b-instruct
# 3. mistralai/mistral-large-2407
NVIDIA_LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Recommended Image Generation & Virtual Try-On models:
# 1. black-forest-labs/flux-1-dev
# 2. stabilityai/stable-diffusion-xl-base-1.0
NVIDIA_IMAGE_MODEL=black-forest-labs/flux-1-dev
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ─── OPTIONAL CUSTOM OPENAI / GROQ / OLLAMA APIS ──────────
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=

# ─── BUSINESS SETTINGS ────────────────────────────────────
WHATSAPP_NUMBER=+919876543210
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173/admin
